@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

@prefix equipment:
    <https://w3id.org/batteryequipment/public/ontology#> .

@prefix machine:
    <https://example.org/equipment/ontology#> .

@prefix machine-ind:
    <https://example.org/equipment-individuals/ontology#> .


<https://example.org/equipment-individuals/ontology>
    rdf:type owl:Ontology ;
    owl:imports <https://example.org/equipment/ontology> ;
    rdfs:label "Equipment individuals ontology"@en ;
    rdfs:comment
        "Equipment-specific individuals used by the equipment wrapper."@en .


# -------------------------------------------------------------------
# Main equipment
# -------------------------------------------------------------------

machine-ind:Machine
    rdf:type machine:MachineEquipment ;
    rdf:type owl:NamedIndividual ;
    rdfs:label "Equipment name"@en ;
    equipment:hasDevice machine-ind:Device1 .


# -------------------------------------------------------------------
# Devices
# -------------------------------------------------------------------

machine-ind:Device1
    rdf:type machine:Device ;
    rdf:type owl:NamedIndividual ;
    rdfs:label "Device name"@en .